{
  "name": "@bucket-broker/authorizer",
  "version": "0.1.0",
  "private": true,
  "description": "API Gateway REQUEST authorizer Lambda: validates incoming JWTs against the IdP JWKS (fail-closed, ADR-0004) and forwards identity + group claims downstream for platform-brokered authorization (ADR-0006). Reuses @bucket-broker/resilience and @bucket-broker/logging.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src __tests__ --ext .ts",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.750.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.50",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
